{
  "id": "com.rdstudio.plugin",
  "name": "RD Studio",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "26"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": "RD Studio",
      "minimumSize": { "width": 300, "height": 500 },
      "maximumSize": { "width": 600, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 700 },
      "preferredFloatingSize": { "width": 320, "height": 700 },
      "icons": [
        { "width": 32, "height": 32, "path": "images/icon@1x.png", "scale": [1,2], "theme": ["dark","darkest"], "species": ["generic"] },
        { "width": 32, "height": 32, "path": "images/icon@2x.png", "scale": [1,2], "theme": ["lightest","light"], "species": ["generic"] }
      ]
    }
  ],
  "icons": [
    { "width": 32, "height": 32, "path": "images/icon@1x.png", "scale": [1,2], "theme": ["dark","darkest"], "species": ["generic"] },
    { "width": 32, "height": 32, "path": "images/icon@2x.png", "scale": [1,2], "theme": ["lightest","light"], "species": ["generic"] }
  ]
}
